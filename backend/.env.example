# Rental OS — environment template
#
#   cp backend/.env.example backend/.env     then fill in real values.
#
# backend/.env is gitignored. Live production credentials live in
# secure/credentials.env (also gitignored) — never commit either file.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Application ──────────────────────────────────────────────────
APP_NAME=Rental OS
APP_VERSION=0.1.0
APP_ENV=development              # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG
# Serve the built frontend (frontend/dist) from this API. On by default because
# the SPA calls relative /api paths, so one service hosts everything. Set false
# to run the API alone.
SERVE_FRONTEND=true

# ── Security ─────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_SECRET=                      # falls back to SECRET_KEY when empty
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ── Database ─────────────────────────────────────────────────────
# A hosted DSN keeps its provider spelling — `?sslmode=require` is translated to
# asyncpg's `ssl`, and a pooler hostname (Neon's `-pooler`, PgBouncer) also
# disables the prepared-statement cache. See app/core/database.py.
#   postgresql+asyncpg://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/rental?sslmode=require
DATABASE_URL=postgresql+asyncpg://imani:imani@localhost:5432/rental
# 30 + 5 suits a local server. Free managed databases cap connections hard —
# on a free tier use 5 + 5 (see render.yaml).
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Tests only (read by `tests/conftest.py`, not by the app). The database-backed
# tenant isolation tests point at a scratch database and reset its schema, so
# never point this at anything you care about. Defaults to DATABASE_URL with
# `_test` appended to the database name. Unset it to skip those tests entirely.
# TEST_DATABASE_URL=postgresql+asyncpg://imani:imani@localhost:5432/rental_test

# ── CORS (comma-separated; required for the desktop/Tauri shell) ─
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── M-PESA Daraja ────────────────────────────────────────────────
# Per-business credentials are captured at enrollment and stored
# encrypted; these are the system-level fallbacks.
MPESA_ENVIRONMENT=sandbox        # sandbox | production
MPESA_SHORTCODE=174379
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE=             # public base URL for Daraja callbacks
# Shared secret appended to the callback URL you register with Daraja:
#   https://<host>/api/v1/payments/mpesa/callback?token=<MPESA_CALLBACK_SECRET>
# Leave empty to skip verification (previous behaviour; not recommended).
MPESA_CALLBACK_SECRET=

# ── Africa's Talking (SMS + WhatsApp) ────────────────────────────
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=Rental OS
AT_WHATSAPP_NUMBER=
AT_WEBHOOK_BASE_URL=             # public URL AT calls back on

# ── Facebook / Instagram bot ─────────────────────────────────────
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
FB_WEBHOOK_SECRET=
IG_BUSINESS_ID=
IG_ACCESS_TOKEN=

# ── Storage ──────────────────────────────────────────────────────
STORAGE_LOCAL_PATH=              # defaults to <repo>/storage

# ── Encryption (M-PESA keys at rest) ─────────────────────────────
ENCRYPTION_KEY=change-me-in-production

# ── Business defaults ────────────────────────────────────────────
DEFAULT_TAX_RATE=0.16

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
