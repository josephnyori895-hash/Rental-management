# Keep the build context small and, more importantly, keep secrets out of it.
# `backend/.env` and `secure/` hold real credentials and must never be baked
# into an image — configuration arrives as environment variables instead.

.git
.gitignore

# Secrets — never in the context
secure/
**/.env
**/.env.*
!**/.env.example

# Python
backend/venv/
backend/venv*/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/
*.log

# Node / frontend
frontend/node_modules/
frontend/dist/

# Local data and desktop build output
storage/
backend/storage/
frontend/src-tauri/target/
docs/

# Redeploying is cheaper than a 121 MB context.
backend/venv.py313.bak/
